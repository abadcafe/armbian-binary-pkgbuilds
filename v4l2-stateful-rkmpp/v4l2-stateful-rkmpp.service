[Unit]
Description=Rockchip MPP V4L2 stateful decoder service
After=systemd-modules-load.service
ConditionPathExists=/dev/v4l2-rkmpp-control

[Service]
Type=simple
User=v4l2-stateful-rkmpp
Group=video
CacheDirectory=v4l2-stateful-rkmpp
Environment=MESA_SHADER_CACHE_DIR=/var/cache/v4l2-stateful-rkmpp
ExecStart=/usr/bin/v4l2-stateful-rkmpp serve /dev/v4l2-rkmpp-control /run/v4l2-stateful-rkmpp/status.sock
ReadWritePaths=/run/v4l2-stateful-rkmpp
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
