pkgname=linux-headers-edge-rockchip64
deburl="https://apt.armbian.com/pool/main/l/linux-headers-edge-rockchip64/linux-headers-edge-rockchip64_25.11.2_arm64__6.18-rc6-S6a23-Deeea-P9106-C43f6Hfdd9-HK01ba-Vc222-B2135-R448a.deb"
debname="$(grep -Po '[^/]+\.deb$' <<< "$deburl")"
debver="$(cut -f2 -d'_' <<< "$debname")"
kver="$(grep -Po '(?<=__)[\d\.]+(-rc\d+)?' <<< "$debname" | head -n1)"
kverl="$(sed -E 's/-rc([0-9]+)$/.0-rc\1/' <<< "$kver")-edge-rockchip64"
pkgver="${kver/-/.}_armbian_${debver/-/.}"
pkgrel=1
pkgdesc="Armbian Linux edge headers $kverl"
arch=('aarch64')
url="https://www.armbian.com/"
license=('GPL2' 'custom')
depends=('python')
install="${pkgname}.install"
source=("$debname::$deburl")
sha256sums=('253e5cee9f2c4e41c59e02954045136fa710cbe95aebb386e89b18656c8be0d4')
options=('!debug' '!strip')

package() {
  cd "$pkgdir"
  tar xvpf "$srcdir"/data.tar.*
  
  mv lib usr/
}
