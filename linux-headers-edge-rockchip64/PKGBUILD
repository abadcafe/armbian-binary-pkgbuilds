pkgname=linux-headers-edge-rockchip64
deburl="https://apt.armbian.com/pool/main/l/linux-headers-edge-rockchip64/linux-headers-edge-rockchip64_26.8.3_arm64__7.1.8-S25c7-D5397-P9a48-Cf756-H2153-HK01ba-Vc222-B4990-R448a.deb"
debname="$(grep -Po '[^/]+\.deb$' <<< "$deburl")"
debver="$(cut -f2 -d'_' <<< "$debname")"
kver="$(grep -Po '(?<=__)[\d\.]+(-rc\d+)?' <<< "$debname" | head -n1)"
kverl="$(sed -E 's/-rc([0-9]+)$/.0-rc\1/' <<< "$kver")-edge-rockchip64"
pkgver="${kver/-/.}_armbian_${debver/-/.}"
pkgrel=2
pkgdesc="Armbian Linux edge headers $kverl"
arch=('aarch64')
url="https://www.armbian.com/"
license=('GPL2' 'custom')
depends=('python' 'pahole')
install="${pkgname}.install"
source=("$debname::$deburl")
sha256sums=('2e6496308bf4895fabe7f473efeabb1f7a1d20170b544e700aa1d21465d94ac9')
options=('!debug' '!strip')

package() {
  cd "$pkgdir"
  tar xvpf "$srcdir"/data.tar.*
  
  mv lib usr/
}
