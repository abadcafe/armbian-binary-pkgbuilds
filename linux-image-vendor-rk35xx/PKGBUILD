pkgname=linux-image-vendor-rk35xx
deburl="https://apt.armbian.com/pool/main/l/linux-6.1.115/linux-image-vendor-rk35xx_25.11.2_arm64__6.1.115-Sf6a8-Deeea-P09c0-Cf4d3Hcd09-HK01ba-Vc222-B2135-R448a.deb"
debname="$(grep -Po '[^/]+\.deb$' <<< "$deburl")"
debver="$(cut -f2 -d'_' <<< "$debname")"
kver="$(grep -Po '(?<=__)[\d\.]+(-rc\d+)?' <<< "$debname" | head -n1)"
kverl="$(sed -E 's/-rc([0-9]+)$/.0-rc\1/' <<< "$kver")-vendor-rk35xx"
pkgver="${kver/-/.}_armbian_${debver/-/.}"
pkgrel=1
pkgdesc="Armbian Linux vendor kernel image $kverl"
arch=('aarch64')
url="https://www.armbian.com/"
license=('GPL2' 'custom')
depends=('coreutils' 'kmod' 'initramfs')
optdepends=(
  'armbian-firmware: firmware images needed for some devices'
  'wireless-regdb: to set the correct wireless channels of your country'
)
source=("$debname::$deburl")
sha256sums=('876a5211e94266eceb02962c90fb76bf48b13beae3b26e415687424a67bd7a8a')
options=('!debug' '!strip')

package() {
  cd "$pkgdir"
  tar xvpf "$srcdir"/data.tar.*

  rm -rf etc
  mv "usr/lib/linux-image-${kverl}" "boot/dtbs-${kverl}"
  mv lib/* usr/lib/
  rm -rf lib

  # this action triggers mkinitcpio to build initramfs and copy vmlinuz.
  mv "boot/vmlinuz-${kverl}" "usr/lib/modules/${kverl}/vmlinuz"
  # mkinitcpio uses content of pkgbase to name vmlinuz, initramfs and
  # generate preset in /etc/mkinitcpio.d
  echo "${kverl}" > "usr/lib/modules/${kverl}/pkgbase"
}
