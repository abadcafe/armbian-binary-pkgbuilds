pkgname=linux-headers-vendor-rk35xx
deburl="https://apt.armbian.com/pool/main/l/linux-headers-vendor-rk35xx/linux-headers-vendor-rk35xx_26.2.1_arm64__6.1.115-S34ab-D1d59-P09c0-C9346-H3522-HK01ba-Vc222-B052a-R448a.deb"
debname="$(grep -Po '[^/]+\.deb$' <<< "$deburl")"
debver="$(cut -f2 -d'_' <<< "$debname")"
kver="$(grep -Po '(?<=__)[\d\.]+(-rc\d+)?' <<< "$debname" | head -n1)"
kverl="$(sed -E 's/-rc([0-9]+)$/.0-rc\1/' <<< "$kver")-vendor-rk35xx"
pkgver="${kver/-/.}_armbian_${debver/-/.}"
pkgrel=1
pkgdesc="Armbian Linux vendor headers $kverl"
arch=('aarch64')
url="https://www.armbian.com/"
license=('GPL2' 'custom')
depends=('python')
install="${pkgname}.install"
source=("$debname::$deburl")
sha256sums=('cb331cf29a5399f4ea5b4ac2c3b27f79314a7e5dee11f05bc9c08859addf9d23')
options=('!debug' '!strip')

package() {
  cd "$pkgdir"
  tar xvpf "$srcdir"/data.tar.*
  
  mv lib usr/
}
