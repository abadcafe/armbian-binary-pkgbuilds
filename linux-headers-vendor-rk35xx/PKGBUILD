pkgname=linux-headers-vendor-rk35xx
deburl="https://apt.armbian.com/pool/main/l/linux-headers-vendor-rk35xx/linux-headers-vendor-rk35xx_25.11.2_arm64__6.1.115-Sf6a8-Deeea-P09c0-Cf4d3Hcd09-HK01ba-Vc222-B2135-R448a.deb"
debname="$(grep -Po '[^/]+\.deb$' <<< "$deburl")"
debver="$(cut -f2 -d'_' <<< "$debname")"
kver="$(grep -Po '(?<=__)[\d\.]+(-rc\d+)?' <<< "$debname" | head -n1)"
kverl="$(sed -E 's/-rc([0-9]+)$/.0-rc\1/' <<< "$kver")-vendor-rk35xx"
pkgver="${kver/-/.}_armbian_${debver/-/.}"
pkgrel=1
pkgdesc="Armbian Linux vendor headers $kverl"
arch=('aarch64')
url="https://www.armbian.com/"
license=('GPL2' 'custom')
depends=('python')
install="${pkgname}.install"
source=("$debname::$deburl")
sha256sums=('fae22e1c57dd175e0b8abeae08fdd2fb373a2fca8f0e00d4988fa1fca7a52f86')
options=('!debug' '!strip')

package() {
  cd "$pkgdir"
  tar xvpf "$srcdir"/data.tar.*
  
  mv lib usr/
}
