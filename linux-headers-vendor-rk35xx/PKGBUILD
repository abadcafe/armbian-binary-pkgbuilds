pkgname=linux-headers-vendor-rk35xx
deburl="https://apt.armbian.com/pool/main/l/linux-headers-vendor-rk35xx/linux-headers-vendor-rk35xx_26.8.3_arm64__6.1.115-S5280-D5397-Pfe89-Ce24e-H213f-HK01ba-Vc222-B4990-R448a.deb"
debname="$(grep -Po '[^/]+\.deb$' <<< "$deburl")"
debver="$(cut -f2 -d'_' <<< "$debname")"
kver="$(grep -Po '(?<=__)[\d\.]+(-rc\d+)?' <<< "$debname" | head -n1)"
kverl="$(sed -E 's/-rc([0-9]+)$/.0-rc\1/' <<< "$kver")-vendor-rk35xx"
pkgver="${kver/-/.}_armbian_${debver/-/.}"
pkgrel=1
pkgdesc="Armbian Linux vendor headers $kverl"
arch=('aarch64')
url="https://www.armbian.com/"
license=('GPL2' 'custom')
depends=('python')
install="${pkgname}.install"
source=("$debname::$deburl")
sha256sums=('da998de3ea8468593501553a1ffe23e5c7545d0a9def69775bda5317eab7c15a')
options=('!debug' '!strip')

package() {
  cd "$pkgdir"
  tar xvpf "$srcdir"/data.tar.*
  
  mv lib usr/
}
